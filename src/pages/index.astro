---
// ===== ページのデータ（ビルド時に1回だけ実行される） =====
const name = "Taku";
const role = "Web Developer"; // TODO: 肩書きは自由に変更
const title = `${name} | Blog`;
const description = `${name}のプロフィールとブログ`;

// 自己紹介（1要素 = 1段落）。TODO: 自分の言葉に書き換え
const about: string[] = [
	"Vue 3 / Nuxt を中心にフロントエンド開発をしています。",
	"現在は Astro と TypeScript を学びながら、このサイトを自作しています。",
];

const skills: string[] = ["TypeScript", "Vue 3", "Nuxt", "Astro", "HTML / CSS"];

type Link = { label: string; url: string };
const links: Link[] = [{ label: "GitHub", url: "https://github.com/taku-ts" }];

// フッターの年号（ビルドした時点の年になる）
const year = new Date().getFullYear();
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<main class="container">
			<!-- ヒーロー：名前と肩書き -->
			<header class="hero">
				<h1>{name}</h1>
				<p class="role">{role}</p>
			</header>

			<section>
				<h2>About</h2>
				{about.map((text) => <p>{text}</p>)}
			</section>

			<section>
				<h2>Skills</h2>
				<ul class="skills">
					{skills.map((skill) => <li>{skill}</li>)}
				</ul>
			</section>

			<section>
				<h2>Links</h2>
				<ul class="links">
					{
						links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Blog</h2>
				<!-- /blog/ は Phase 3 で作るので、今はリンクにしない -->
				<p class="muted">準備中です。</p>
			</section>

			<footer class="footer">
				<small>&copy; {year} {name}</small>
			</footer>
		</main>
	</body>
</html>

<!-- サイト全体に効かせる土台（色の変数・body） -->
<style is:global>
	:root {
		color-scheme: dark; /* スクロールバーやフォーム部品もダーク表示に */
		--color-bg: #0f1115;
		--color-surface: #1a1d24;
		--color-border: #2a2f3a;
		--color-text: #e6e8eb;
		--color-muted: #9aa3af;
		--color-accent: #7dd3fc;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif;
		line-height: 1.8;
	}
</style>

<!-- このページだけに効くスタイル（Astroが自動でスコープする） -->
<style>
	.container {
		max-width: 640px;
		margin: 0 auto;
		padding: 64px 16px;
	}

	.hero {
		margin-bottom: 48px;
	}

	h1 {
		margin: 0;
		font-size: 2.5rem;
		line-height: 1.2;
	}

	.role {
		margin: 8px 0 0;
		color: var(--color-accent);
	}

	section {
		margin-bottom: 40px;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 1.1rem;
		color: var(--color-muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	p {
		margin: 0 0 8px;
	}

	.muted {
		color: var(--color-muted);
	}

	/* スキルはタグ風に横並び */
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skills li {
		padding: 2px 12px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.9rem;
	}

	.links {
		margin: 0;
		padding-left: 1.2em;
	}

	a {
		color: var(--color-accent);
		text-underline-offset: 3px;
	}

	a:hover {
		text-decoration-thickness: 2px;
	}

	.footer {
		margin-top: 64px;
		padding-top: 16px;
		border-top: 1px solid var(--color-border);
		color: var(--color-muted);
	}
</style>
